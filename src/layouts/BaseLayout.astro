---
// 共通レイアウト（基本設計書 §3.3）
import '@fontsource-variable/noto-sans-jp';
import '@fontsource/biz-udgothic/400.css';
import '@fontsource/biz-udgothic/700.css';
import '../styles/global.css';
import { headScript, languageCss } from '../build/site';
import { IS_PRERELEASE, NEW_ISSUE_URL, SITE_NAME } from '../config';

interface Props {
  /** ページの見出し。タブの名前は「見出し | サイト名」になる */
  title?: string;
  description?: string;
}

const { title, description = '車載の題材で、オブジェクト指向の設計の違いを「変更のしやすさ」で体感する学習サイト' } =
  Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<!-- 表示言語の既定値は Java（詳細設計書 §5.4） -->
<html lang="ja" data-lang="java">
  <head>
    <meta charset="utf-8" />
    <!-- 描画の前に表示言語を決める（詳細設計書 §5.4）。CSP のハッシュ値は astro.config で同じものから作る -->
    <script is:inline set:html={headScript()} />
    <style is:inline set:html={languageCss()} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    {
      IS_PRERELEASE && (
        <p class="prerelease" role="note">
          このサイトは公開準備中です。内容は予告なく変わります。
        </p>
      )
    }
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-name" href="/">{SITE_NAME}</a>
        <nav aria-label="サイト内の移動">
          <ul class="site-nav">
            <li><a href="/">概念一覧</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="container site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <ul class="footer-nav">
          <li><a href="/about/">このサイトについて</a></li>
          <li><a href={NEW_ISSUE_URL} rel="noopener noreferrer" target="_blank">誤りを報告する（GitHub Issues）</a></li>
          <li><a href="/about/#license">ライセンス</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .prerelease {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--color-notice-bg);
    border-bottom: 1px solid var(--color-notice-border);
    text-align: center;
    font-size: 0.9rem;
  }

  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
  }

  .site-name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-nav,
  .footer-nav {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-main {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    min-height: 60vh;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
