---
// SC-02d クイズ（基本設計書 §3.9、要件定義書 FR-050〜054）。正解データはページに含めない（NFR-15 ③）
import ConceptLayout from '../../../layouts/ConceptLayout.astro';
import NoScriptNotice from '../../../components/NoScriptNotice.astro';
import Quiz from '../../../components/Quiz';
import { buildQuizPageData } from '../../../build/page-data';
import { conceptPaths, siteContent, siteHighlighter } from '../../../build/site';

export const getStaticPaths = () => conceptPaths();

const { concept } = Astro.props;
const data = buildQuizPageData(concept, siteContent(), await siteHighlighter());
---

<ConceptLayout concept={concept} tab="quiz">
  <NoScriptNotice />
  <Quiz client:load data={data} />
</ConceptLayout>
