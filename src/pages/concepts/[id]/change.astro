---
// SC-02c 変更シミュレーション（基本設計書 §3.8、要件定義書 FR-040〜045）
import ConceptLayout from '../../../layouts/ConceptLayout.astro';
import ChangeSimulator from '../../../components/ChangeSimulator';
import NoScriptNotice from '../../../components/NoScriptNotice.astro';
import SpecDetails from '../../../components/SpecDetails.astro';
import { buildChangePageData } from '../../../build/page-data';
import { conceptPaths, siteContent, siteHighlighter } from '../../../build/site';

export const getStaticPaths = () => conceptPaths();

const { concept } = Astro.props;
const data = buildChangePageData(concept, siteContent(), await siteHighlighter());
---

<ConceptLayout concept={concept} tab="change">
  <SpecDetails concept={concept} />
  <NoScriptNotice />
  <ChangeSimulator client:load data={data} />
</ConceptLayout>
