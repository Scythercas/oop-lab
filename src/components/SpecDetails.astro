---
// 題材の仕様（「仕様を見る」。要件定義書 FR-030）
import type { Concept } from '../content/loader';
import { renderConceptMarkdown } from '../build/page-data';

interface Props {
  concept: Concept;
}

const { concept } = Astro.props;
---

<details class="spec">
  <summary>仕様を見る</summary>
  <div class="prose" set:html={renderConceptMarkdown(concept, concept.spec)} />
</details>
